{
  "name": "inkledger-tattoo-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "start": "tsx server.ts --start-server",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "theme:light": "node scripts/build-light-theme.mjs",
    "sri:probar": "node --experimental-strip-types --no-warnings scripts/probar-sri-autorizacion.ts",
    "sri:parser": "node --experimental-strip-types --no-warnings scripts/probar-sri-parser.ts",
    "sri:mongo": "node --experimental-strip-types --no-warnings scripts/probar-sri-mongo.ts",
    "server": "tsx server.ts --start-server",
    "tunnel": "powershell -ExecutionPolicy Bypass -File scripts/iniciar-tunel-cloudflare.ps1",
    "sri:api": "node --experimental-strip-types --no-warnings scripts/probar-sri-api.ts",
    "sri:final": "node --experimental-strip-types --no-warnings scripts/probar-sri-final.ts",
    "sri:test": "npm run sri:probar && npm run sri:parser && npm run sri:mongo && npm run sri:api && npm run sri:final"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.0",
    "imapflow": "^1.7.8",
    "lucide-react": "^0.546.0",
    "mailparser": "^3.14.2",
    "mongodb": "^6.22.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
